Menu backdrop for the pinned RT64 (applied by CMakeLists.txt; src/main/rt64_context.cpp update_menu_aspect drives it).

The game's full-screen menus switch the picture to 4:3 (settings.json menus_4_3), which RT64 presents with black bars
in a wide window. PresentQueue gains backdropCapture / backdropShow: while capturing, a copy of the presented picture
is kept every fourth frame (copyTexture into backdropTexture, with the VI state and render parameters it was drawn
with); while showing, that copy is drawn first by a second VIRenderer (its own descriptor set) where it was, darkened
through the VI gamma (RenderParams::gammaScale 2.2), and the 4:3 picture over it.

diff --git i/src/hle/rt64_present_queue.cpp w/src/hle/rt64_present_queue.cpp
index 3227ab1..657fffc 100644
--- i/src/hle/rt64_present_queue.cpp
+++ w/src/hle/rt64_present_queue.cpp
@@ -87,6 +87,7 @@ namespace RT64 {
         this->ext = ext;
 
         viRenderer = std::make_unique<VIRenderer>();
+        backdropRenderer = std::make_unique<VIRenderer>();
 
         presentThreadRunning = true;
         presentThread = new std::thread(&PresentQueue::threadLoop, this);
@@ -340,9 +341,37 @@ namespace RT64 {
                     }
                 }
                 
+                // Menu backdrop: while it is wanted, keep a copy of the picture every fourth frame; while it is shown,
+                // draw the kept one darkened first, where it was, and the picture over it.
+                const bool showBackdrop = backdropShow && (backdropTexture != nullptr);
+                if (!showBackdrop && backdropCapture && (renderParams.texture != nullptr) && ((backdropFrame++ % 4) == 0)) {
+                    if ((backdropTexture == nullptr) || (backdropParams.textureWidth != renderParams.textureWidth) ||
+                        (backdropParams.textureHeight != renderParams.textureHeight) || (backdropParams.textureFormat != renderParams.textureFormat))
+                    {
+                        backdropTexture = ext.device->createTexture(RenderTextureDesc::Texture2D(renderParams.textureWidth, renderParams.textureHeight, 1, renderParams.textureFormat));
+                        backdropTexture->setName("Menu Backdrop");
+                    }
+
+                    commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(renderParams.texture, RenderTextureLayout::COPY_SOURCE));
+                    commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(backdropTexture.get(), RenderTextureLayout::COPY_DEST));
+                    commandList->copyTexture(backdropTexture.get(), renderParams.texture);
+                    commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(backdropTexture.get(), RenderTextureLayout::SHADER_READ));
+                    backdropVI = present.screenVI;
+                    backdropParams = renderParams;
+                    backdropParams.texture = backdropTexture.get();
+                    backdropParams.vi = &backdropVI;
+                    backdropParams.gammaScale = 2.2f;
+                }
+
                 commandList->setFramebuffer(swapChainFramebuffer);
                 commandList->clearColor();
 
+                if (showBackdrop) {
+                    backdropParams.commandList = commandList;
+                    backdropParams.swapChain = ext.swapChain;
+                    backdropRenderer->render(backdropParams);
+                }
+
                 if (renderParams.texture != nullptr) {
                     commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(renderParams.texture, RenderTextureLayout::SHADER_READ));
                     viRenderer->render(renderParams);

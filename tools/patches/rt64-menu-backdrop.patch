+
+        // Menu backdrop. While backdropCapture is set, a copy of the presented picture is kept every few frames; while
+        // backdropShow is set, the kept copy is drawn darkened under the picture, so a narrower picture (a game's 4:3
+        // menu in a wide window) sits over the last wide one, frozen and dimmed, instead of black bars.
+        std::atomic<bool> backdropCapture = false;
+        std::atomic<bool> backdropShow = false;
+        std::unique_ptr<VIRenderer> backdropRenderer;
+        std::unique_ptr<RenderTexture> backdropTexture;
+        VIRenderer::RenderParams backdropParams;
+        VI backdropVI;
+        uint32_t backdropFrame = 0;
+
         std::unique_ptr<Inspector> inspector;
         ProfilingTimer presentProfiler = ProfilingTimer(120);
         Timestamp presentTimestamp;

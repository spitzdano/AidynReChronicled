# rt64-pack-lookup.patch: a texture's file is looked up in the pack's file list (listed just before) instead of on the disk:
# under Wine every missing name (each texture is tried as .dds first) costs a scan of its whole folder, minutes for a
# 30,000-file pack. Faster everywhere, the same result.
diff --git i/src/common/rt64_replacement_database.cpp w/src/common/rt64_replacement_database.cpp

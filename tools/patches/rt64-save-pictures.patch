+    // Aidyn ReChronicled (tools/patches/rt64-save-pictures.patch): where in RDRAM the data last loaded into the tile's
+    // TMEM address starts (as dumpTexture works it out).
+    static uint32_t loadedRdramAddress(const State *state, const LoadTile &loadTile) {
+        const LoadOperation &loadOp = state->rdp->rice.lastLoadOpByTMEM[loadTile.tmem];
+        const uint32_t commonBytesOffset = (loadOp.tile.uls >> 2) << loadOp.texture.siz >> 1;
+        const uint32_t commonBytesPerRow = loadOp.texture.width << loadOp.texture.siz >> 1;
+        if (loadOp.type == LoadOperation::Type::Block) {
+            return loadOp.texture.address + commonBytesOffset + commonBytesPerRow * loadOp.tile.ult;
+        }
+        else if (loadOp.type == LoadOperation::Type::Tile) {
+            return loadOp.texture.address + commonBytesOffset + commonBytesPerRow * (loadOp.tile.ult >> 2);
+        }
+
+        return loadOp.texture.address;
+    }

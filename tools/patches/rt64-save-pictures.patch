diff --git i/src/shaders/GapFillCS.hlsl w/src/shaders/GapFillCS.hlsl
new file mode 100644
index 0000000..f895f69
--- /dev/null
+++ w/src/shaders/GapFillCS.hlsl
@@ -0,0 +1,113 @@
+//
+// RT64
+//
+// Aidyn ReChronicled (tools/patches/rt64-save-pictures.patch): fills hairline gaps between separately drawn geometry.
+// N64 meshes meet with sub-pixel cracks that vanished at 320x240 and show as thin lines of background at high
+// resolution. A pixel where some depth samples were never drawn (still the cleared 1.0), between drawn pixels on both
+// sides along a row or a column, takes their colours (blended by distance) when the gap between them is no wider than
+// about three quarters of an N64 pixel. Below the horizon (HorizonY, from the game's sky) the ground is everywhere, so
+// any background there is a hole and gaps up to four N64 pixels are filled, a gap's width counting its background
+// only (from the first pixel with a drawn sample on each side: anti-aliased edges don't widen it). Above the horizon
+// (and with no sky) the width runs between fully drawn pixels, so the sky between leaves stays. Wider stretches are
+// left as they are. The colours come from the first fully drawn pixels on each side.
+//
+
+#define BLOCK_SIZE 8
+#define MAX_GAP_LIMIT 40
+#define EDGE_REACH 2    // how far past a gap's edge (a partly drawn pixel) a fully drawn one is looked for
+#define SOLID 0.0f      // the colours taken come from fully drawn pixels only: an edge pixel's resolved colour holds sky
+
+struct GapFillCB {
+    int2 Resolution;
+    int MaxGap;       // widest gap filled, in pixels: about three quarters of an N64 pixel at this resolution
+    int MaxGapBelow;  // ... at or below HorizonY: about four
+    int HorizonY;     // the first row below the horizon (with a margin), or -1 (no sky)
+    int3 Padding;
+};
+
+[[vk::push_constant]] ConstantBuffer<GapFillCB> gConstants : register(b0);
+Texture2D<float4> gInput : register(t1);
+#ifdef MULTISAMPLING
+Texture2DMS<float> gDepth : register(t2);
+#else
+Texture2D<float> gDepth : register(t2);
+#endif
+RWTexture2D<float4> gOutput : register(u3);
+
+// How much of a pixel shows background: the fraction of its depth samples still at the cleared depth.
+float BackgroundFraction(int2 coord) {
+    if (any(coord < 0) || any(coord >= gConstants.Resolution)) {
+        return 1.0f;
+    }
+
+#ifdef MULTISAMPLING
+    uint width, height, sampleCount;
+    gDepth.GetDimensions(width, height, sampleCount);
+    uint background = 0;
+    for (uint i = 0; i < sampleCount; i++) {
+        background += (gDepth.Load(coord, i) >= 1.0f) ? 1 : 0;
+    }
+
+    return float(background) / float(sampleCount);
+#else
+    return (gDepth.Load(int3(coord, 0)) >= 1.0f) ? 1.0f : 0.0f;
+#endif
+}
+
+// From coord along step: the distance to the gap's edge, within maxGap (the first pixel with a drawn sample, or with
+// toSolid the first fully drawn one), and to the first fully drawn pixel from there (within EDGE_REACH past it); 0 for
+// none.
+void FindSide(int2 coord, int2 step, int maxGap, bool toSolid, out int edge, out int solid) {
+    edge = 0;
+    solid = 0;
+    for (int d = 1; (d <= maxGap) && (edge == 0); d++) {
+        const float background = BackgroundFraction(coord + step * d);
+        if (toSolid ? (background <= SOLID) : (background < 1.0f)) {
+            edge = d;
+            solid = (background <= SOLID) ? d : 0;
+        }
+    }
+
+    for (int d = edge + 1; (edge > 0) && (solid == 0) && (d <= edge + EDGE_REACH); d++) {
+        solid = (BackgroundFraction(coord + step * d) <= SOLID) ? d : 0;
+    }
+}
+
+[numthreads(BLOCK_SIZE, BLOCK_SIZE, 1)]
+void CSMain(uint2 coord : SV_DispatchThreadID) {
+    if (any(int2(coord) >= gConstants.Resolution)) {
+        return;
+    }
+
+    float4 color = gInput.Load(int3(coord, 0));
+    float background = BackgroundFraction(int2(coord));
+    if (background > 0.0f) {
+        // Along a row and along a column: the gap's edges on each side and the drawn pixels past them. A gap at most
+        // maxGap pixels wide is filled, the colour blended between the two by distance; the narrower of the two wins.
+        const int2 axes[2] = { int2(1, 0), int2(0, 1) };
+        const bool below = (gConstants.HorizonY >= 0) && (int(coord.y) >= gConstants.HorizonY);
+        const int maxGap = min(below ? gConstants.MaxGapBelow : gConstants.MaxGap, MAX_GAP_LIMIT);
+        int bestWidth = maxGap + 1;
+        float4 fill = color;
+        for (int a = 0; a < 2; a++) {
+            int beforeEdge, beforeSolid, afterEdge, afterSolid;
+            FindSide(int2(coord), -axes[a], maxGap, !below, beforeEdge, beforeSolid);
+            FindSide(int2(coord), axes[a], maxGap, !below, afterEdge, afterSolid);
+            const int width = beforeEdge + afterEdge - 1;
+            if ((beforeSolid > 0) && (afterSolid > 0) && (width < bestWidth)) {
+                bestWidth = width;
+                float4 colorBefore = gInput.Load(int3(int2(coord) - axes[a] * beforeSolid, 0));
+                float4 colorAfter = gInput.Load(int3(int2(coord) + axes[a] * afterSolid, 0));
+                fill = lerp(colorBefore, colorAfter, float(beforeSolid) / float(beforeSolid + afterSolid));
+            }
+        }
+
+        if (bestWidth <= maxGap) {
+            // Replaced whole, not blended by the background share: a partly covered pixel's resolved colour already
+            // holds that much sky, and blending would leave a faint line.
+            color = fill;
+        }
+    }
+
+    gOutput[coord] = color;
+}

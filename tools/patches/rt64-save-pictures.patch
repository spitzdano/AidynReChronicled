diff --git i/src/shaders/GapFillCS.hlsl w/src/shaders/GapFillCS.hlsl
new file mode 100644
index 0000000..06f98e2
--- /dev/null
+++ w/src/shaders/GapFillCS.hlsl
@@ -0,0 +1,92 @@
+//
+// RT64
+//
+// Aidyn ReChronicled (tools/patches/rt64-save-pictures.patch): fills hairline gaps between separately drawn geometry.
+// N64 meshes meet with sub-pixel cracks that vanished at 320x240 and show as thin lines of background at high
+// resolution. A pixel where some depth samples were never drawn (still the cleared 1.0) and whose neighbours on both
+// sides along a row or a column were (at least half) drawn, within a gap no wider than about three quarters of an N64
+// pixel, takes their colours (blended by distance). Wider stretches of background are left as they are.
+//
+
+#define BLOCK_SIZE 8
+#define MAX_GAP_LIMIT 16
+#define SOLID 0.5f  // a pixel counts as drawn when at most this much of it is background (multisampled edges)
+
+struct GapFillCB {
+    int2 Resolution;
+    int MaxGap;  // widest gap filled, in pixels: about three quarters of an N64 pixel at this resolution
+    int Padding;
+};
+
+[[vk::push_constant]] ConstantBuffer<GapFillCB> gConstants : register(b0);
+Texture2D<float4> gInput : register(t1);
+#ifdef MULTISAMPLING
+Texture2DMS<float> gDepth : register(t2);
+#else
+Texture2D<float> gDepth : register(t2);
+#endif
+RWTexture2D<float4> gOutput : register(u3);
+
+// How much of a pixel shows background: the fraction of its depth samples still at the cleared depth.
+float BackgroundFraction(int2 coord) {
+    if (any(coord < 0) || any(coord >= gConstants.Resolution)) {
+        return 1.0f;
+    }
+
+#ifdef MULTISAMPLING
+    uint width, height, sampleCount;
+    gDepth.GetDimensions(width, height, sampleCount);
+    uint background = 0;
+    for (uint i = 0; i < sampleCount; i++) {
+        background += (gDepth.Load(coord, i) >= 1.0f) ? 1 : 0;
+    }
+
+    return float(background) / float(sampleCount);
+#else
+    return (gDepth.Load(int3(coord, 0)) >= 1.0f) ? 1.0f : 0.0f;
+#endif
+}
+
+[numthreads(BLOCK_SIZE, BLOCK_SIZE, 1)]
+void CSMain(uint2 coord : SV_DispatchThreadID) {
+    if (any(int2(coord) >= gConstants.Resolution)) {
+        return;
+    }
+
+    float4 color = gInput.Load(int3(coord, 0));
+    float background = BackgroundFraction(int2(coord));
+    if (background > 0.0f) {
+        // Along a row and along a column: the nearest drawn pixel on each side. A gap at most MaxGap pixels wide
+        // between them is filled, the colour blended between the two by distance; the narrower of the two gaps wins.
+        const int2 axes[2] = { int2(1, 0), int2(0, 1) };
+        const int maxGap = min(gConstants.MaxGap, MAX_GAP_LIMIT);
+        int bestWidth = maxGap + 1;
+        float4 fill = color;
+        for (int a = 0; a < 2; a++) {
+            int before = 0, after = 0;
+            for (int d = 1; (d <= maxGap) && (before == 0); d++) {
+                before = (BackgroundFraction(int2(coord) - axes[a] * d) <= SOLID) ? d : 0;
+            }
+
+            for (int d = 1; (d <= maxGap) && (after == 0); d++) {
+                after = (BackgroundFraction(int2(coord) + axes[a] * d) <= SOLID) ? d : 0;
+            }
+
+            const int width = before + after - 1;
+            if ((before > 0) && (after > 0) && (width < bestWidth)) {
+                bestWidth = width;
+                float4 colorBefore = gInput.Load(int3(int2(coord) - axes[a] * before, 0));
+                float4 colorAfter = gInput.Load(int3(int2(coord) + axes[a] * after, 0));
+                fill = lerp(colorBefore, colorAfter, float(before) / float(before + after));
+            }
+        }
+
+        if (bestWidth <= maxGap) {
+            // Replaced whole, not blended by the background share: a partly covered pixel's resolved colour already
+            // holds that much sky, and blending would leave a faint line.
+            color = fill;
+        }
+    }
+
+    gOutput[coord] = color;
+}

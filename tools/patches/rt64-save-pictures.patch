+    void WorkloadQueue::threadCaptureFramebuffers() {
+        std::vector<SharedQueueResources::FramebufferCapture> captures;
+        {
+            std::scoped_lock<std::mutex> captureLock(ext.sharedResources->framebufferCaptureMutex);
+            captures.swap(ext.sharedResources->framebufferCaptures);
+        }
+
+        for (SharedQueueResources::FramebufferCapture &capture : captures) {
+            std::vector<uint8_t> rgba;
+            uint32_t width = 0;
+            uint32_t height = 0;
+            {
+                std::scoped_lock<std::mutex> managerLock(ext.sharedResources->workloadMutex);
+                std::scoped_lock<std::mutex> workerLock(workerMutex);
+                Framebuffer *fb = ext.sharedResources->framebufferManager.find(capture.address);
+                RenderTarget *target = nullptr;
+                if (fb != nullptr) {
+                    RenderTargetKey targetKey(fb->addressStart, fb->width, fb->siz, Framebuffer::Type::Color);
+                    target = &ext.sharedResources->renderTargetManager.get(targetKey, true);
+                }
+
+                if ((target != nullptr) && !target->isEmpty()) {
+                    const float scaleX = float(target->resolutionScale.x);
+                    const float scaleY = float(target->resolutionScale.y);
+                    const float centreX = (capture.left + capture.right) * 0.5f * scaleX;
+                    const float halfWidth = (capture.right - capture.left) * 0.5f * scaleY;
+                    const int32_t left = std::clamp(int32_t(lround(centreX - halfWidth)), 0, int32_t(target->width));
+                    const int32_t right = std::clamp(int32_t(lround(centreX + halfWidth)), 0, int32_t(target->width));
+                    const int32_t top = std::clamp(int32_t(lround(capture.top * scaleY)), 0, int32_t(target->height));
+                    const int32_t bottom = std::clamp(int32_t(lround(capture.bottom * scaleY)), 0, int32_t(target->height));
+                    if ((right > left) && (bottom > top)) {
+                        width = uint32_t(right - left);
+                        height = uint32_t(bottom - top);
+
+                        RenderWorker *worker = ext.workloadGraphicsWorker;
+                        const RenderFormat format = target->format;
+                        const uint32_t texelSize = RenderFormatSize(format);
+                        const uint32_t rowWidth = (width + 63) & ~63U;
+                        std::unique_ptr<RenderBuffer> readbackBuffer = worker->device->createBuffer(RenderBufferDesc::ReadbackBuffer(uint64_t(rowWidth) * texelSize * height));
+                        worker->commandList->begin();
+                        target->resolveTarget(worker, ext.shaderLibrary);
+                        RenderTexture *texture = target->getResolvedTexture();
+                        worker->commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(texture, RenderTextureLayout::COPY_SOURCE));
+                        const RenderBox srcBox(left, top, right, bottom);
+                        worker->commandList->copyTextureRegion(
+                            RenderTextureCopyLocation::PlacedFootprint(readbackBuffer.get(), format, width, height, 1, rowWidth),
+                            RenderTextureCopyLocation::Subresource(texture), 0, 0, 0, &srcBox);
+                        worker->commandList->barriers(RenderBarrierStage::GRAPHICS_AND_COMPUTE, RenderTextureBarrier(texture, RenderTextureLayout::SHADER_READ));
+                        worker->commandList->end();
+                        worker->execute();
+                        worker->wait();
+
+                        const RenderRange readRange(0, uint64_t(rowWidth) * texelSize * height);
+                        const uint8_t *data = reinterpret_cast<const uint8_t *>(readbackBuffer->map(0, &readRange));
+                        rgba.resize(size_t(width) * height * 4);
+                        for (uint32_t y = 0; y < height; y++) {
+                            const uint8_t *src = data + size_t(y) * rowWidth * texelSize;
+                            uint8_t *dst = rgba.data() + size_t(y) * width * 4;
+                            for (uint32_t x = 0; x < width; x++) {
+                                if (format == RenderFormat::R16G16B16A16_UNORM) {
+                                    // Each channel's high byte (little-endian 16-bit values).
+                                    dst[x * 4 + 0] = src[x * 8 + 1];
+                                    dst[x * 4 + 1] = src[x * 8 + 3];
+                                    dst[x * 4 + 2] = src[x * 8 + 5];
+                                }
+                                else {
+                                    dst[x * 4 + 0] = src[x * 4 + 0];
+                                    dst[x * 4 + 1] = src[x * 4 + 1];
+                                    dst[x * 4 + 2] = src[x * 4 + 2];
+                                }
+
+                                dst[x * 4 + 3] = 255;
+                            }
+                        }
+
+                        readbackBuffer->unmap();

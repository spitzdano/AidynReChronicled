# version.cmake: writes OUT (aidyn_version.h) with the version the title screen shows (src/game/patches.cpp, "Title
# screen"), only when it changed, so a build recompiles only then. CMakeLists.txt runs it on every build.
#   FIXED set (make_release.sh passes the release's version, e.g. 0.4.0): "v0.4.0"
#   else from git (SRC): on a release tag, clean: "v0.4.0"; anything after or changed: "v0.4.0 dev"; no git or no tag: "dev"
if (FIXED)
    set(text "v${FIXED}")
else()
    set(text "dev")
    find_package(Git QUIET)
    if (GIT_FOUND)
        execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SRC} describe --tags --match "v[0-9]*" --long --dirty
                        OUTPUT_VARIABLE described RESULT_VARIABLE failed OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if (NOT failed AND described MATCHES "^(v[0-9]+\\.[0-9]+\\.[0-9]+)-([0-9]+)-g[0-9a-f]+(-dirty)?$")
            if (CMAKE_MATCH_2 STREQUAL "0" AND NOT CMAKE_MATCH_3)
                set(text "${CMAKE_MATCH_1}")
            else()
                set(text "${CMAKE_MATCH_1} dev")
            endif()
        endif()
    endif()
endif()
set(content "// Generated by tools/version.cmake on every build: the version the title screen shows.\n#pragma once\n#define AIDYN_VERSION_TEXT \"${text}\"\n")
if (EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if (NOT old STREQUAL content)
    file(WRITE ${OUT} "${content}")
endif()

# tools/toolkit.env: where this project finds the N64 recomp toolkit.
# new-game.sh wrote the path below; set N64RECOMP_TOOLKIT to override it.
TOOLKIT=${N64RECOMP_TOOLKIT:-/home/dan/Work/n64-recomp-toolkit}
if [[ ! -x $TOOLKIT/bin/N64Recomp || ! -x $TOOLKIT/.venv/bin/python ]]; then
    echo "toolkit not found or not built at $TOOLKIT (set N64RECOMP_TOOLKIT, or run its build.sh)" >&2
    exit 1
fi

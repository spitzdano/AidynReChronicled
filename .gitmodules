[submodule "lib/N64ModernRuntime"]
	path = lib/N64ModernRuntime
	url = https://github.com/N64Recomp/N64ModernRuntime.git
[submodule "lib/rt64"]
	path = lib/rt64
	url = https://github.com/rt64/rt64.git
	ignore = dirty
[submodule "decomp"]
	path = decomp
	url = https://github.com/blackgamma7/Aidyn.git
[submodule "art"]
	path = art
	url = git@github.com:spitzdano/AidynReChronicled-Art.git
[submodule "sound"]
	path = sound
	url = git@github.com:spitzdano/AidynReChronicled-Sound.git
